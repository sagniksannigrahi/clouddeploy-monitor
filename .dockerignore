# Files Docker should NOT send into the image build.
# Keeps the image small and stops local junk or secrets leaking into it.
.venv/
__pycache__/
*.pyc
.pytest_cache/
.git/
.github/
.gitignore
.dockerignore
.env
.env.*
.DS_Store
.vscode/
test_app.py
requirements-dev.txt
README.md
docs/
Dockerfile
deploy.sh
*.pem
*.key
